#define _POSIX_C_SOURCE 200809L

#include <errno.h>
#include <pthread.h>
#include <signal.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <unistd.h>

#define JOB_COUNT 8
#define WORKER_COUNT 2
#define AGING_POINTS 3

enum { WAITING, RUNNING, DONE };

typedef struct {
    int number;
    const char *name;
    const char *type;
    int starting_priority;
    int work_ms;
    int arrival_ms;
    int start_ms;
    int finish_ms;
    int state;
} Job;

static Job *jobs;
static int finished_count = 0;
static int message_pipe[2];
static volatile sig_atomic_t stop_requested = 0;
static pthread_mutex_t job_lock = PTHREAD_MUTEX_INITIALIZER;
static pthread_cond_t job_ready = PTHREAD_COND_INITIALIZER;
static struct timespec program_start;

static void handle_stop(int signal_number)
{
    (void)signal_number;
    stop_requested = 1;
}

static int elapsed_ms(void)
{
    struct timespec now;
    clock_gettime(CLOCK_MONOTONIC, &now);

    return (int)((now.tv_sec - program_start.tv_sec) * 1000
        + (now.tv_nsec - program_start.tv_nsec) / 1000000);
}

/* Each full second a job waits adds 3 priority points. */
static int current_priority(const Job *job, int now_ms)
{
    int waited_seconds = (now_ms - job->arrival_ms) / 1000;
    return job->starting_priority + waited_seconds * AGING_POINTS;
}

static void *worker(void *worker_number)
{
    long number = (long)(intptr_t)worker_number;

    while (1) {
        pthread_mutex_lock(&job_lock);

        int chosen = -1;
        int highest_priority = -1;

        while (chosen == -1 && finished_count < JOB_COUNT && !stop_requested) {
            int now = elapsed_ms();

            for (int i = 0; i < JOB_COUNT; i++) {
                if (jobs[i].state == WAITING) {
                    int points = current_priority(&jobs[i], now);

                    if (points > highest_priority) {
                        highest_priority = points;
                        chosen = i;
                    }
                }
            }

            if (chosen == -1) {
                pthread_cond_wait(&job_ready, &job_lock);
            }
        }

        if (stop_requested || finished_count == JOB_COUNT) {
            pthread_mutex_unlock(&job_lock);
            break;
        }

        Job *job = &jobs[chosen];
        job->state = RUNNING;
        job->start_ms = elapsed_ms();

        int waited_seconds = (job->start_ms - job->arrival_ms) / 1000;

        printf("\nHelper %ld picked: %s\n", number, job->name);
        printf("  Waited about %d seconds; priority is now %d points.\n",
               waited_seconds, highest_priority);
        printf("  State: WAITING -> RUNNING\n");

        pthread_mutex_unlock(&job_lock);

        struct timespec work_time = {
            job->work_ms / 1000,
            (job->work_ms % 1000) * 1000000L
        };

        while (nanosleep(&work_time, &work_time) == -1 && errno == EINTR) {
            /* Finish the remaining work if a signal interrupts the wait. */
        }

        pthread_mutex_lock(&job_lock);

        job->finish_ms = elapsed_ms();
        job->state = DONE;
        finished_count++;

        /* Send a small completion message through the pipe. */
        (void)write(message_pipe[1], &job->number, sizeof(job->number));

        printf("  Done: %s\n", job->name);
        printf("  State: RUNNING -> DONE\n");

        pthread_cond_broadcast(&job_ready);
        pthread_mutex_unlock(&job_lock);
    }

    return NULL;
}

static void save_report(void)
{
    FILE *file = fopen("online_class_report.csv", "w");

    if (file == NULL) {
        perror("Could not save report");
        return;
    }

    fprintf(file, "number,job,type,starting_priority,wait_ms,finish_ms\n");

    int completed = 0;
    long total_wait_ms = 0;

    for (int i = 0; i < JOB_COUNT; i++) {
        Job *job = &jobs[i];
        int wait_ms = -1;

        if (job->state == DONE) {
            wait_ms = job->start_ms - job->arrival_ms;
            total_wait_ms += wait_ms;
            completed++;
        }
"%d,%s,%s,%d,%d,%d\n",
                job->number,
                job->name,
                job->type,
                job->starting_priority,
                wait_ms,
                job->finish_ms);
    }

    fclose(file);

    printf("\n========== RESULTS ==========\n");
    printf("Finished %d out of %d jobs.\n", completed, JOB_COUNT);

    if (completed > 0) {
        printf("Average wait before starting: %ld milliseconds.\n",
               total_wait_ms / completed);
    }

    printf("Report saved as online_class_report.csv\n");
}

int main(void)
{
    static const char *names[JOB_COUNT] = {
        "Online class audio",
        "Online class video",
        "Teacher screen sharing",
        "Student typing notes",
        "Download class notes",
        "Cloud file sync",
        "Computer updates",
        "File backup"
    };

    static const char *types[JOB_COUNT] = {
        "CLASS", "CLASS", "CLASS", "CLASS",
        "BACKGROUND", "BACKGROUND", "BACKGROUND", "BACKGROUND"
    };

    static const int priorities[JOB_COUNT] = {10, 9, 8, 7, 3, 2, 1, 1};
    static const int work_times[JOB_COUNT] = {900, 1100, 800, 650, 900, 1000, 800, 700};

    signal(SIGINT, handle_stop);
    clock_gettime(CLOCK_MONOTONIC, &program_start);

    jobs = calloc(JOB_COUNT, sizeof(Job));

    if (jobs == NULL) {
        perror("Could not create jobs");
        return 1;
    }

    for (int i = 0; i < JOB_COUNT; i++) {
        jobs[i].number = i + 1;
        jobs[i].name = names[i];
        jobs[i].type = types[i];
        jobs[i].starting_priority = priorities[i];
        jobs[i].work_ms = work_times[i];
        jobs[i].arrival_ms = 0;
        jobs[i].start_ms = -1;
        jobs[i].finish_ms = 0;
        jobs[i].state = WAITING;
    }

    if (pipe(message_pipe) == -1) {
        perror("Could not create pipe");
        free(jobs);
        return 1;
    }

    printf("=====================================\n");
    printf("       ONLINE CLASS LAG SAVER\n");
    printf("=====================================\n");
    printf("Two helpers share the computer work.\n");
    printf("Class jobs start with more priority.\n");
    printf("A waiting job gains 3 points each second.\n");
    printf("Press Ctrl+C to ask the helpers to stop.\n");

    pthread_t helpers[WORKER_COUNT];

    for (long i = 0; i < WORKER_COUNT; i++) {
        int result = pthread_create(&helpers[i], NULL, worker,
                                    (void *)(intptr_t)(i + 1));
        if (result != 0) {
            fprintf(stderr, "Could not start helper thread.\n");
            stop_requested = 1;
            pthread_cond_broadcast(&job_ready);
            for (long j = 0; j < i; j++) {
                pthread_join(helpers[j], NULL);
            }
            close(message_pipe[0]);
            close(message_pipe[1]);
            free(jobs);
            return 1;
        }
    }

    for (int i = 0; i < WORKER_COUNT; i++) {
        pthread_join(helpers[i], NULL);
    }

    close(message_pipe[1]);

    int completed_job_number;
    int messages_received = 0;

    while (read(message_pipe[0], &completed_job_number,
                sizeof(completed_job_number)) == sizeof(completed_job_number)) {
        messages_received++;
    }

    close(message_pipe[0]);

    printf("\nThe helpers sent %d finish messages through a pipe.\n",
           messages_received);

    if (stop_requested) {
        printf("Stop requested. The helpers stopped safely.\n");
    }

    save_report();

    free(jobs);
    printf("Job memory cleaned up.\n");

    return 0;
}

